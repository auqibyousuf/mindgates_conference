{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "mindgatesconference",
  "account_id": "4942421717b64dea6563f65c1081e51d",
  "compatibility_date": "2026-05-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mindgatesconference"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "MINDGATES_DATA",
      "id": "d5bea23310f24ffe862ec5d21849acef"
    }
  ]
}
